<Window x:Class="WallpaperEngine.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Wallpaper Engine"
        Width="900" Height="700" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Desktop Wallpaper Engine" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Phase 2 - Static wallpapers" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,24"/>

            <!-- Wallpaper -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Wallpaper" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Apply to" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                      DisplayMemberPath="Label" Width="220"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Fit mode" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Fits}" SelectedItem="{Binding SelectedFit}" Width="160"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Choose image..." Command="{Binding ChooseWallpaperCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Restore original" Command="{Binding RestoreOriginalCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Refresh monitors" Command="{Binding RefreshMonitorsCommand}" Padding="12,6"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Height="170"
                            HorizontalAlignment="Left" MinWidth="300">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- General -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8"/>
                    <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" Margin="0,0,0,8"/>
                    <CheckBox Content="Close button hides to tray" IsChecked="{Binding CloseToTray}" Margin="0,0,0,16"/>

                    <TextBlock Text="Theme" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              Width="180" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Data" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DataFolder}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Open logs" Command="{Binding OpenLogsFolderCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Exit app" Command="{Binding ExitAppCommand}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>