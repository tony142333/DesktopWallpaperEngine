<UserControl x:Class="WallpaperEngine.UI.PanicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="20">
        <StackPanel>
            <TextBlock Text="Panic button" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <CheckBox Content="Enable global panic hotkey" IsChecked="{Binding Enabled}" Margin="0,0,0,12"/>

            <TextBlock Text="Hotkey (click the box, then press your combination)" Margin="0,0,0,4"/>
            <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyText, Mode=OneWay}" IsReadOnly="True"
                     Width="260" HorizontalAlignment="Left" Padding="6,4" Margin="0,0,0,12"
                     IsEnabled="{Binding Enabled}"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

            <CheckBox Content="Hide this window when panic triggers" IsChecked="{Binding HideWindow}" Margin="0,0,0,12"/>

            <Button Content="{Binding ToggleButtonText}" Command="{Binding TogglePanicCommand}"
                    Padding="12,6" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>